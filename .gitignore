# Dependencies and build output
node_modules
dist
src-tauri/target
src-tauri/gen
# Regenerated from build.rs on every build
src-tauri/permissions/autogenerated
*.tsbuildinfo
.vite
coverage

# graphify knowledge graph: generated locally, with absolute paths and a per-machine cache.
# Rebuild with /graphify . (or --update).
graphify-out/
.graphify_*

# Installers and binaries copied out of the build folder
*.msi
*.exe
*.zip

# Secrets: environment files, Tauri updater signing keys and code-signing certificates.
# Runtime secrets (Last.fm session, companion tokens) live in the OS credential store and
# the app config directory, never in the repository.
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.cer
*.crt
*.jks
*.keystore
*.secret
secrets.*
credentials.*

# App data that may be copied here while debugging (settings, state, logs)
config.json
state.json
*.log

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea
*.swp
.DS_Store
Thumbs.db
desktop.ini

resume.txt
